---
import Layout from '../layouts/Layout.astro';

const INTERNAL_API = import.meta.env.INTERNAL_API_URL || 'http://localhost:8080';

let activities: any[] = [];
let error: string | null = null;

try {
  const loginRes = await fetch(`${INTERNAL_API}/api/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: 'admin@clearline.local', password: 'admin123' }),
  });
  if (loginRes.ok) {
    const { token } = await loginRes.json();
    const res = await fetch(`${INTERNAL_API}/api/activities`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    activities = await res.json();
  }
} catch (e: any) {
  error = e.message;
}

const activityIcons: Record<string, string> = {
  call: '📞',
  email: '✉️',
  meeting: '🤝',
  note: '📝',
  task: '✅',
};

const typeColors: Record<string, string> = {
  call: 'bg-green-100 text-green-700',
  email: 'bg-blue-100 text-blue-700',
  meeting: 'bg-purple-100 text-purple-700',
  note: 'bg-yellow-100 text-yellow-700',
  task: 'bg-gray-100 text-gray-700',
};
---

<Layout title="Activities — ClearLine CRM">
  <div class="min-h-screen bg-gray-50">
    <header class="bg-white border-b border-gray-200 px-6 py-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">CL</span>
          </div>
          <span class="text-xl font-semibold text-gray-900">ClearLine CRM</span>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/" class="text-gray-500 hover:text-gray-800">Dashboard</a>
          <a href="/contacts" class="text-gray-500 hover:text-gray-800">Contacts</a>
          <a href="/deals" class="text-gray-500 hover:text-gray-800">Deals</a>
          <a href="/activities" class="text-blue-600 font-medium">Activities</a>
        </nav>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <span class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-bold">A</span>
          <span>Admin User</span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-8">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Activity Timeline</h1>
        <span class="text-sm text-gray-400">{activities.length} events</span>
      </div>

      {error && (
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">⚠️ {error}</div>
      )}

      <div class="relative">
        <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-gray-200"></div>
        <div class="space-y-6">
          {activities.map((a: any) => (
            <div class="flex gap-4 relative">
              <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center flex-shrink-0 z-10">
                <span class="text-base">{activityIcons[a.type] || '📋'}</span>
              </div>
              <div class="flex-1 bg-white rounded-xl border border-gray-200 p-4">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900">{a.subject}</h3>
                    {a.body && (
                      <p class="text-sm text-gray-500 mt-1">{a.body}</p>
                    )}
                  </div>
                  <span class={`text-xs font-medium px-2 py-0.5 rounded-full flex-shrink-0 ${typeColors[a.type]}`}>
                    {a.type}
                  </span>
                </div>
                <div class="flex items-center gap-3 mt-3 text-xs text-gray-400">
                  {a.user_name && <span>👤 {a.user_name}</span>}
                  <span>🕐 {new Date(a.occurred_at).toLocaleString()}</span>
                </div>
              </div>
            </div>
          ))}
          {activities.length === 0 && (
            <div class="text-center py-16 text-gray-400">
              <p class="text-4xl mb-3">📋</p>
              <p class="text-sm">No activities logged yet.</p>
            </div>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>
